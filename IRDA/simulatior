import numpy as np
import random

from network import Network
from config import Config, Metrics
from routing import RoutingProtocol


class IRDASimulator:
    def __init__(self):
        self.net = Network()
        self.protocol = RoutingProtocol(self.net)

    def run(self):
        SIMULATION_ROUNDS = 5000

        for r in range(1, SIMULATION_ROUNDS + 1):
            should_continue = self.protocol.perform_round(r)
            if not should_continue:
                break

        stats = self.protocol.stats

        # Calculate PDR
        pdr = 0
        if stats.total_packets_generated > 0:
            pdr = (stats.total_packets_delivered /
                   stats.total_packets_generated) * 100

        # Calculate Delay
        avg_delay = 0
        if stats.delay_samples > 0:
            avg_delay = stats.total_delay_sum / stats.delay_samples

        return {
            'FND': stats.fnd,
            'HND': stats.hnd,
            'LND': stats.lnd,
            'Total_Packet_Generated': stats.total_packets_generated,
            'Total_Packet_Delivered': stats.total_packets_delivered,
            'PDR': pdr,
            'Avg_Delay': avg_delay,
            'Total_Residual_Energy': np.sum(self.net.energies[self.net.energies > 0])
        }


def run_multiple_simulations(n_runs):
    FND, HND, LND, PDR = [], [], [], []
    TotalGenerated = []
    TotalDelivered = []
    AvgDelay = []

    for seed in range(n_runs):
        np.random.seed(seed)
        random.seed(seed)
        sim = IRDASimulator()
        metrics = sim.run()
        FND.append(metrics['FND'])
        HND.append(metrics['HND'])
        LND.append(metrics['LND'])
        TotalGenerated.append(metrics['Total_Packet_Generated'])
        TotalDelivered.append(metrics['Total_Packet_Delivered'])
        PDR.append(metrics['PDR'])
        AvgDelay.append(metrics['Avg_Delay'])

        print(
            f"Run {seed + 1}: \n LND = {metrics['LND']} \n TotalGenerated = {metrics['Total_Packet_Generated']} \n TotalDelivered = {metrics['Total_Packet_Delivered']} \n PDR = {metrics['PDR']:.2f}% \n AvgDelay = {metrics['Avg_Delay']:.4f}s")

    return [np.array(FND), np.array(HND), np.array(LND), np.array(TotalGenerated), np.array(TotalDelivered), np.array(PDR), np.array(AvgDelay)]


if __name__ == "__main__":
    # Set seed for reproducibility
    n_runs = 30  # Number of simulations to run
    result_metrics = run_multiple_simulations(n_runs)

    print("\n" + "="*50)
    print("SUMMARY OF SIMULATION RESULTS")
    print("="*50)
    print(
        f"Mean result FND: {result_metrics[0].mean():.2f} ± {result_metrics[0].std():.2f}")
    print(
        f"Mean result HND: {result_metrics[1].mean():.2f} ± {result_metrics[1].std():.2f}")
    print(
        f"Mean result LND: {result_metrics[2].mean():.2f} ± {result_metrics[2].std():.2f}")
    print(
        f"Mean result total data generated: {result_metrics[3].mean():.2f} ± {result_metrics[3].std():.2f}")
    print(
        f"Mean result total data delivered: {result_metrics[4].mean():.2f} ± {result_metrics[4].std():.2f}")
    print(
        f"Mean result PDR: {result_metrics[5].mean():.2f}% ± {result_metrics[5].std():.2f}%")
    print(
        f"Mean result Avg Delay: {result_metrics[6].mean():.4f}s ± {result_metrics[6].std():.4f}s")
    print("="*50)


